<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid Margin="24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandGradient}">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="17" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Xuefiest" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource App.Tagline}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" Margin="40,0,28,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Tag="{DynamicResource Main.Search}" Padding="36,10,12,10"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Faint}"
                           Margin="14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddBtn" Style="{StaticResource Primary}"
                        ToolTip="{DynamicResource Main.AddTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                        <TextBlock Text="{DynamicResource Main.Add}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshBtn" Style="{StaticResource Ghost}" Margin="8,0,0,0" ToolTip="{DynamicResource Main.Refresh}">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="15"/>
                </Button>
                <Button x:Name="SettingsBtn" Style="{StaticResource Ghost}" Margin="2,0,0,0" ToolTip="{DynamicResource Main.Settings}">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Library and detail panel -->
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="28,22,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="4,0,22,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Main.Library}" Style="{StaticResource H1}"/>
                    <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="9,2" Margin="12,3,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="0" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowToolsBox" Style="{StaticResource Switch}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Main.ShowTools}" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                    </CheckBox>
                    <Button x:Name="CheckAllBtn" Margin="16,0,0,0"
                            ToolTip="{DynamicResource Main.CheckAllTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Main.CheckAll}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ListBox x:Name="GameList" Grid.Row="1" Style="{StaticResource PlainList}" Padding="0,0,18,16"
                     ItemContainerStyle="{StaticResource CardItem}" ItemTemplate="{StaticResource GameCard}"/>

            <StackPanel x:Name="EmptyLibrary" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyLibraryText" Text="" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </Grid>

        <!-- Detail panel -->
        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <Grid>
                <StackPanel x:Name="EmptyDetail" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Main.PickGame}" Style="{StaticResource H2}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Main.PickGameHint}" Style="{StaticResource Caption}"
                               TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Height="196">
                            <Border Background="{StaticResource CoverPlaceholder}"/>
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Hero}" Stretch="UniformToFill" AlignmentY="Top"/>
                                </Border.Background>
                            </Border>
                            <Border Background="{StaticResource HeroFade}"/>
                            <Image Source="{Binding Logo}" MaxHeight="72" MaxWidth="250" Stretch="Uniform"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,24,10"/>
                        </Grid>

                        <StackPanel Margin="24,10,24,28">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                            <Border HorizontalAlignment="Left" Margin="0,14,0,0" CornerRadius="12" Padding="10,4" Background="{Binding StatusSoftBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0" CornerRadius="10" Background="{StaticResource Surface2}" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource Detail.Installed}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,24,3"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledBuild}" FontSize="12.5" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Detail.Latest}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,24,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestBuild}" FontSize="12.5" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Text="{DynamicResource Detail.Size}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,24,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Text="{DynamicResource Detail.Location}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,24,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Location}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,3"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/>
                                </Grid>
                            </Border>

                            <Border x:Name="Notice" Margin="0,14,0,0" CornerRadius="10" Padding="14,11" Visibility="Collapsed" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NoticeIcon" Style="{StaticResource Icon}" FontSize="15" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                    <TextBlock x:Name="NoticeText" Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                                </Grid>
                            </Border>

                            <Button x:Name="FreezeBtn" Style="{StaticResource Primary}" Margin="0,18,0,0" Padding="16,11" HorizontalContentAlignment="Center"
                                    ToolTip="{DynamicResource Detail.FreezeTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Detail.Freeze}" Margin="9,0,0,0" FontSize="13.5"/>
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CheckBtn" HorizontalContentAlignment="Center" ToolTip="{DynamicResource Detail.CheckTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock Text="{DynamicResource Detail.Check}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestoreBtn" Grid.Column="2" HorizontalContentAlignment="Center"
                                        ToolTip="{DynamicResource Detail.RestoreTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock Text="{DynamicResource Detail.Restore}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="{DynamicResource Detail.Options}" Style="{StaticResource Overline}" Margin="2,26,0,10"/>
                            <CheckBox x:Name="OnlyOnLaunchBox" Style="{StaticResource Switch}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Opt.OnLaunch}" FontSize="13"/>
                                    <TextBlock Text="{DynamicResource Opt.OnLaunchHint}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ClearCacheBox" Style="{StaticResource Switch}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Opt.ClearCache}" FontSize="13"/>
                                    <TextBlock Text="{DynamicResource Opt.ClearCacheHint}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <!-- Log -->
    <Border x:Name="LogPanel" Grid.Row="2" Height="190" Visibility="Collapsed" Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0"
                 FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" Padding="20,10"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="20,0,12,0" Height="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Main.Ready}" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="BusyPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Width="140" IsIndeterminate="True"/>
                <Button x:Name="CancelBtn" Style="{StaticResource Ghost}" Margin="10,0,0,0" Padding="10,5">
                    <TextBlock Text="{DynamicResource Common.Stop}" FontSize="12"/>
                </Button>
            </StackPanel>
            <Button x:Name="LogBtn" Grid.Column="2" Style="{StaticResource Ghost}" Margin="12,0,0,0" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="12"/>
                    <TextBlock Text="{DynamicResource Main.Log}" FontSize="12" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Grid>
