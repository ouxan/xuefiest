<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="14" Margin="24">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <StackPanel Width="440">
        <Grid Margin="24,22,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBg" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,22,24,20">
            <Button x:Name="SecondaryBtn" IsCancel="True"/>
            <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Border>
