<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="28,24,28,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource BrandGradient}" VerticalAlignment="Top">
            <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="19" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Create.Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{DynamicResource Create.Subtitle}"
                       Style="{StaticResource Caption}" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,20,0">
        <StackPanel Margin="0,0,8,20">

            <!-- 1: folder -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Create.Step1}" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Tag="{DynamicResource Create.FolderPh}"/>
                        <Button x:Name="BrowseBtn" Grid.Column="1" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="{DynamicResource Create.Browse}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="FolderHintPanel" Orientation="Horizontal" Margin="2,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="FolderHintIcon" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock x:Name="FolderHint" Style="{StaticResource Caption}" MaxWidth="600"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2: game -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Create.Step2}" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AppIdBox" Tag="{DynamicResource Create.AppIdPh}"/>
                        <Button x:Name="SearchBtn" Grid.Column="1" Margin="8,0,0,0" ToolTip="{DynamicResource Create.SearchTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="{DynamicResource Create.Search}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FetchBtn" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Primary}"
                                ToolTip="{DynamicResource Create.FetchTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="{DynamicResource Create.Fetch}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="AppIdHint" Style="{StaticResource Caption}" Margin="2,10,0,0" Visibility="Collapsed"/>

                    <ListBox x:Name="SearchList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                             MaxHeight="230" Margin="0,12,0,0" Padding="0,0,14,0" Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="92" Height="35" CornerRadius="5" Background="{StaticResource Surface3}">
                                        <Border CornerRadius="5">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding IdText}" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="GamePreview" Margin="0,14,0,0" CornerRadius="10" Background="{StaticResource Surface2}" Padding="12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="184" Height="86" CornerRadius="7" Background="{StaticResource CoverPlaceholder}">
                                <Border CornerRadius="7">
                                    <Border.Background>
                                        <ImageBrush x:Name="PreviewImage" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewName" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PreviewInfo" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3: content -->
            <Border x:Name="ContentCard" Style="{StaticResource Card}" Margin="0,14,0,0" IsEnabled="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Create.Step3}" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Create.Step3Hint}"
                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Create.Language}" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                            <ComboBox x:Name="LangCombo" Width="190"/>
                        </StackPanel>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{DynamicResource Create.Branch}" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                            <TextBox x:Name="BranchBox" Width="150" Text="public"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="DepotPlaceholder" Text="{DynamicResource Create.DepotPh}"
                               Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" Margin="2,16,0,0"/>
                    <Border x:Name="DepotBox" Margin="0,16,0,0" CornerRadius="10" Background="{StaticResource Surface2}" Padding="6" Visibility="Collapsed">
                        <ItemsControl x:Name="DepotList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="7" Padding="10,9" Opacity="{Binding RowOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Tags}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Warning}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface3}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="Progress" Width="90" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseBtn" Content="{DynamicResource Common.Close}" IsCancel="True"/>
                <Button x:Name="CreateBtn" Style="{StaticResource Primary}" Margin="8,0,0,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock Text="{DynamicResource Create.Create}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
