<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="28,24,28,16">
        <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource H1}"/>
        <TextBlock Text="{DynamicResource Settings.Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="28,0,28,20">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.UiLanguage}" Style="{StaticResource Overline}" Margin="2,0,0,8"/>
                <ComboBox x:Name="LangCombo" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Tag="en" Content="English"/>
                    <ComboBoxItem Tag="tr" Content="Türkçe"/>
                </ComboBox>

                <TextBlock Text="{DynamicResource Settings.SteamFolder}" Style="{StaticResource Overline}" Margin="2,22,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SteamBox" Tag="C:\Program Files (x86)\Steam"/>
                    <Button x:Name="SteamBrowseBtn" Grid.Column="1" Margin="8,0,0,0" ToolTip="{DynamicResource Common.Browse}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button x:Name="SteamDetectBtn" Grid.Column="2" Margin="8,0,0,0" Content="{DynamicResource Settings.Detect}"/>
                </Grid>
                <TextBlock x:Name="SteamHint" Style="{StaticResource Caption}" Margin="2,8,0,0"/>

                <TextBlock Text="STEAMCMD" Style="{StaticResource Overline}" Margin="2,22,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CmdBox" Tag="{DynamicResource Settings.CmdPh}"/>
                    <Button x:Name="CmdBrowseBtn" Grid.Column="1" Margin="8,0,0,0" ToolTip="{DynamicResource Common.Browse}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button x:Name="CmdInstallBtn" Grid.Column="2" Margin="8,0,0,0" ToolTip="{DynamicResource Settings.InstallTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Settings.Install}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="CmdHint" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
                <ProgressBar x:Name="Progress" Margin="2,10,2,0" Visibility="Collapsed" Minimum="0" Maximum="100"/>
            </StackPanel>
        </Border>
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,14">
            <Button x:Name="CancelBtn" Content="{DynamicResource Common.Cancel}" IsCancel="True"/>
            <Button x:Name="SaveBtn" Content="{DynamicResource Common.Save}" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
    </Border>
</Grid>
